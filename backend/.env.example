# ---- Gemini Multimodal AI ----
# Get a key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ---- Supabase ----
# Project Settings > API in your Supabase dashboard
SUPABASE_URL=
SUPABASE_KEY=

# ---- Google Maps (optional) ----
# If left empty, RepairConnect automatically falls back to sample
# technician data stored in Supabase / the in-memory demo dataset.
GOOGLE_MAPS_API_KEY=

# ---- App ----
FRONTEND_URL=http://localhost:5173

# Set to "true" to force RepairConnect into demo/mock mode even if
# GEMINI_API_KEY / SUPABASE_URL are present. Useful for local dev without
# spending API credits.
FORCE_DEMO_MODE=false
